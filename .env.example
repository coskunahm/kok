# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını kimseyle paylaşmayın.
# Alan adı (katılımcıların açacağı adres), örn. kok.kurumunuz.com.tr; DNS'te sunucunuzun IP'sine yönlenmiş olmalı
ALAN_ADI=kok.ornek.com.tr
# Yönetim paneli PIN'i: uzun ve tahmin edilmesi zor yapın (en az 8 karakter)
ADMIN_PIN=BURAYA-UZUN-BIR-PIN
# Kayıt masası PIN'i (yönetim PIN'inden farklı olsun)
KAYIT_PIN=BURAYA-BASKA-BIR-PIN
# Yalnızca kurum içi ağdaysanız (genel sertifika alınamıyorsa) açın:
# TLS_AYARI=tls internal
